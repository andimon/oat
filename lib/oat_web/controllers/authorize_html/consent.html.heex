<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-md rounded-2xl border border-base-300 bg-base-100 p-8 shadow-sm">
    <p class="text-sm text-base-content/60">Authorization request</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight">
      Allow <span id="client-name">{@request.client.name}</span> to access your account?
    </h1>

    <div class="mt-6">
      <p class="text-sm font-medium">It is asking for these scopes:</p>
      <ul id="scopes" class="mt-3 flex flex-wrap gap-2">
        <li
          :for={scope <- Enum.sort(@request.scopes)}
          class="rounded-full bg-base-200 px-3 py-1 font-mono text-xs"
        >
          {scope}
        </li>
      </ul>
    </div>

    <p class="mt-6 text-sm text-base-content/60">
      You will be sent back to <span class="break-all font-mono">{@request.redirect_uri}</span>
    </p>

    <form id="consent-form" method="post" action={~p"/oauth/authorize"} class="mt-8 flex gap-3">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="request" value={@query} />
      <button
        type="submit"
        name="decision"
        value="deny"
        class="flex-1 rounded-lg border border-base-300 px-4 py-2 font-medium transition hover:bg-base-200"
      >
        Deny
      </button>
      <button
        type="submit"
        name="decision"
        value="approve"
        class="flex-1 rounded-lg bg-primary px-4 py-2 font-medium text-primary-content transition hover:opacity-90"
      >
        Allow
      </button>
    </form>
  </div>
</Layouts.app>
